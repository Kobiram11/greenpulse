AWS_IOT_ENDPOINT=YOUR_ENDPOINT-ats.iot.YOUR_REGION.amazonaws.com
DEVICE_ID=YOUR_EXISTING_THING_NAME
AWS_REGION=ap-southeast-1
DYNAMODB_TABLE=GreenPulseEvents
MQTT_CLIENT_ID=greenpulse-backend
MQTT_CA_PATH=./certs/AmazonRootCA1.pem
MQTT_CERT_PATH=./certs/backend-certificate.pem.crt
MQTT_KEY_PATH=./certs/backend-private.pem.key
SPOOL_PATH=./data/spool.db
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
CARE_INTERVAL_SECONDS=300
PLANT_NAME=Enter your plant species
# Demonstration thresholds; calibrate before using for real care decisions.
DRY_THRESHOLD=20
WARNING_THRESHOLD=35
# Set the actual plant location; blank disables real weather until configured.
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
# Enable only after configuring your own real mailbox (read-only).
EMAIL_ENABLED=false
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
EMAIL_KEYWORDS=plant,watering,garden,weather
